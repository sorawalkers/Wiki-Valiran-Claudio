# Supabase — service_role key (Supabase Dashboard → Project Settings → API → service_role)
# ATENÇÃO: nunca commitar o .env com esses valores reais. wiki_chunks só
# aceita escrita da service_role key (ver project-backend/schema-rag.sql).
SUPABASE_URL=https://ytphxqybjxokokbnnbrz.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# Gemini — Google AI Studio (aistudio.google.com/apikey). O tier free
# tem um limite de requests/minuto; index-wiki.js já faz os embeddings
# em lotes pequenos com uma pausa entre eles por causa disso.
GEMINI_API_KEY=sua_gemini_api_key_aqui
